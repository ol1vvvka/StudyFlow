<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0D7A6F</Color>
    <Color x:Key="PrimaryDark">#5FD3C2</Color>
    <Color x:Key="PrimaryDarkText">#0F1716</Color>
    <Color x:Key="Secondary">#D4EFE9</Color>
    <Color x:Key="SecondaryDarkText">#8FDCCF</Color>
    <Color x:Key="Tertiary">#0A5A52</Color>

    <Color x:Key="Accent">#FF7A59</Color>
    <Color x:Key="AccentStrong">#E85D3A</Color>
    <Color x:Key="ActionBackground">#0D7A6F</Color>
    <Color x:Key="ActionText">#FFFFFF</Color>
    <Color x:Key="SelectedBackgroundLight">#D4EFE9</Color>
    <Color x:Key="SelectedBackgroundDark">#3D4D4A</Color>
    <Color x:Key="TextSecondaryLight">#5E726E</Color>
    <Color x:Key="TextSecondaryDark">#8C9A96</Color>
    <Color x:Key="BorderLight">#C7D0CD</Color>
    <Color x:Key="BorderDark">#3D4D4A</Color>
    <Color x:Key="ErrorLight">#B3261E</Color>
    <Color x:Key="ErrorDark">#FFB4AB</Color>

    <Color x:Key="DarkBackground">#0F1716</Color>
    <Color x:Key="LightOnDarkBackground">#DDEBE8</Color>
    <Color x:Key="LightBackground">#F0F6F4</Color>
    <Color x:Key="DarkOnLightBackground">#12302C</Color>

    <Color x:Key="LightSecondaryBackground">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryBackground">#18221F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#12302C</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E7E5</Color>
    <Color x:Key="Gray200">#C7D0CD</Color>
    <Color x:Key="Gray300">#A9B5B1</Color>
    <Color x:Key="Gray400">#8C9A96</Color>
    <Color x:Key="Gray500">#5E726E</Color>
    <Color x:Key="Gray600">#3D4D4A</Color>
    <Color x:Key="Gray900">#1C2624</Color>
    <Color x:Key="Gray950">#121918</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="ActionBackgroundBrush" Color="{StaticResource ActionBackground}"/>
    <SolidColorBrush x:Key="LightSecondaryBackgroundBrush" Color="{StaticResource LightSecondaryBackground}"/>
    <SolidColorBrush x:Key="DarkSecondaryBackgroundBrush" Color="{StaticResource DarkSecondaryBackground}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
