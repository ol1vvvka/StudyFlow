<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:StudyFlow.PageModels"
             xmlns:models="clr-namespace:StudyFlow.Models"
             xmlns:controls="clr-namespace:StudyFlow.Pages.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:strings="clr-namespace:StudyFlow.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StudyFlow.Pages.SubjectListPage"
             x:Name="SubjectList"
             x:DataType="pageModels:SubjectListPageModel"
             Title="{x:Static strings:AppResources.NavSubjects}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                x:Name="AppearingBehavior"
                BindingContext="{Binding Path=BindingContext, Source={x:Reference SubjectList}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>
    <Grid>
        <CollectionView ItemsSource="{Binding Subjects}"
            Margin="{StaticResource LayoutPadding}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.SubjectsEmpty}" Style="{StaticResource Body2}" Margin="0,20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="7.5"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Subject">
                    <Border Style="{StaticResource CardStyle}"
                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}"
                        SemanticProperties.Description="{Binding AccessibilityDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding NavigateToSubjectCommand, Source={RelativeSource AncestorType={x:Type pageModels:SubjectListPageModel}}, x:DataType=pageModels:SubjectListPageModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{Binding DisplayColor}"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding Icon}"
                                    FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                    FontSize="24"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource Title3}" />
                                <Label Text="{Binding Teacher}" IsVisible="{Binding HasTeacher}" Style="{StaticResource Body2}" />
                                <Label
                                    Text="{Binding Stats}"
                                    Style="{StaticResource Caption1}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:AddButton
            Command="{Binding AddSubjectCommand}"
            SemanticProperties.Description="{x:Static strings:AppResources.AddSubject}"
            ToolTipProperties.Text="{x:Static strings:AppResources.AddSubject}" />
    </Grid>
</ContentPage>
